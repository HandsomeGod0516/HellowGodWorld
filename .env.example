# GOD - Govern, Observe, Direct
# Copy this file to .env, or just run `./scripts/god.sh start`.

# ----- Optional model defaults ---------------------------------------------
# Every AI resident carries its own endpoint, set in the control room when you
# add them. These values only prefill the "Add resident" form, so you can leave
# them blank and configure each resident individually.
# GOD_LLM_PROVIDER accepts `ollama`, `openai` (any OpenAI-compatible server), or `anthropic` (Claude).
GOD_LLM_PROVIDER=ollama
GOD_LLM_API_BASE=http://localhost:11434
GOD_LLM_MODEL=
GOD_LLM_API_KEY=

# Local bind ports. Override only on port conflicts.
GOD_BACKEND_HOST=127.0.0.1
GOD_BACKEND_PORT=8001
GOD_FRONTEND_PORT=5174

# Set to 1 to skip dependency checks/install when starting.
GOD_SKIP_SETUP=0
